-- === OFFSET LOADER ===
local function dec(v)
    if type(v) == "string" and v:sub(1, 2):lower() == "0x" then
        return tonumber(v, 16)
    end
    return tonumber(v)
end

local function flatten(t, res, vis)
    if type(t) ~= "table" then return end
    vis = vis or {}
    if vis[t] then return end
    vis[t] = true
    for k, v in pairs(t) do
        if k:find("%s") then continue end
        if type(v) == "table" then
            flatten(v, res, vis)
        else
            local d = dec(v)
            if d and not res[k] then
                res[k] = d
            end
        end
    end
end

